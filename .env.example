# 하나를 명시적으로 선택: local | openai | gemini
# 실행 스크립트가 이 값을 덮어쓰지 않는다.
LLM_PROVIDER=local
# 고객 용어 챗봇에서 검색된 약관 근거를 LLM으로 쉽게 설명
LLM_CHAT_ENABLED=true
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_HEALTH_TIMEOUT_SECONDS=3

# 로컬 Gemma (앱 8000/8080/8081과 충돌하지 않는 별도 8002 포트)
LOCAL_BASE_URL=http://127.0.0.1:8002/v1
LOCAL_MODEL=gemma-4-e4b
LOCAL_API_KEY=not-needed

# 외부 API를 쓸 때만 키를 채우고 위 LLM_PROVIDER를 바꾼다.
# 키는 절대 Git에 커밋하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 인증 (JWT) — 반드시 설정. 미설정 시 auth 사용은 ConfigError(503)로 실패
# 운영에서는 임의의 긴 난수로 교체할 것
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# APP_ENV=production을 지정하면 PostgreSQL cutover 검사가 강제된다.
# 미지정 개발 환경만 아래 SQLite 호환 기본값을 사용할 수 있다.
# APP_ENV=production
# DB — 운영에서는 SQLite를 사용하지 않는다.
# DATABASE_URL=sqlite:///./data/db/insurance.sqlite3
# 운영 cutover는 config/production.env.example을 기준으로 PostgreSQL DSN을 주입한다.

# 합성 에이전트 제출·검증 저장소. postgres는 별도 insurance_demo DB를 사용하며
# 연결 실패 시 file로 자동 폴백하지 않는다.
DEMO_STORE_BACKEND=postgres
DEMO_PG_DSN=host=127.0.0.1 port=5433 user=postgres dbname=insurance_demo

# 실제 보험 업무 원장. insurance_runtime은 insurance_app role의 멤버인 LOGIN role로
# 별도 생성한다. 미설정/장애 시 SQLite·demo·file 저장소로 폴백하지 않는다.
# INSURANCE_PG_DSN=host=127.0.0.1 port=5433 user=insurance_runtime dbname=insurance_real
# INSURANCE_ADMIN_PG_DSN=host=127.0.0.1 port=5433 user=insurance_admin dbname=insurance_real
# AUTH_PERSISTENCE=postgres
# OPS_PERSISTENCE=postgres
# 조항 저장소. file=파일 어댑터 / pg=pgvector.
#   ★2026-08-25 이전에는 이 값이 os.getenv 로만 읽혀 .env 에 적어도 무시됐다.
#   지금은 Settings 필드라 여기서 먹는다. 미설정이면 file 이다(판정은 그래도 돈다).
# CLAUSE_STORE=pg
# SQLITE_LEGACY_ENABLED=false
# PRECHECK_PERSISTENCE=postgres
# OUTCOME_PERSISTENCE=postgres
# VERIFIED_COHORT_STORE=postgres
# AGENT_REAL_LEDGER_ENABLED=false
# INSURANCE_IDEMPOTENCY_SECRET=replace-with-a-separate-random-secret-at-least-32-chars

# 등록 외부 에이전트 전용 API. 고객 UI(8080)·합성 DB와 분리한다.
# 준비 순서: python -m scripts.pg init-agent → client 발급 → true로 전환.
AGENT_API_ENABLED=false
AGENT_PG_DSN=host=127.0.0.1 port=5433 user=insurance_agent_runtime dbname=insurance_agent
AGENT_ADMIN_PG_DSN=host=127.0.0.1 port=5433 user=insurance_agent_admin dbname=insurance_agent
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8082
ALLOW_REMOTE_AGENT_BIND=false
# JWT SECRET_KEY와 다른 32자 이상 난수. subject/request/trace 원문 대신 HMAC에만 쓴다.
AGENT_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-chars

# 보험 조항 검색 리랭커 모델 설정
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
# Low-latency fallback measured on the same S6 candidate set:
RERANKER_FALLBACK_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_DTYPE=float16
RERANKER_BATCH_SIZE=1
RERANKER_MAX_LENGTH=768
RERANKER_OVER_FETCH=20
RERANKER_TRUST_REMOTE_CODE=false

# ─────────────────────────────────────────────────────────────────────
# 보험 조항 리랭킹
#
# ★켜는 방법: 아래 한 줄을 true 로 바꾸고 서버를 다시 띄운다.
#     INSURANCE_CLAUSE_RERANK_ENABLED=true
#   그러면 /api/admin/clause-search 의 rerank=true 가 열린다(운영서버 8081 전용,
#   로그인 필요). 나머지 값은 실측으로 정해 둔 것이라 그대로 두면 된다.
#
# ★켜기 전에 확인할 것
#   · GPU 가 있어야 한다. CPU 는 질의당 42초다(GPU 2.3초) — 사실상 불가.
#   · Qwen3-Reranker-4B 는 fp16 로 VRAM 약 9GB 를 쓴다(12GB 카드에서 실측).
#   · 첫 요청에서 **전용 워커**가 뜨며 무게추를 받는다(적재+예열 수십 초).
#     그 적재는 워커 스레드에서 일어나므로 요청 경로를 막지 않지만,
#     첫 요청은 워커가 준비될 때까지 기다린다.
#   · 시한을 넘기면 504. ★단 추론은 안 멈춘다 — 그동안 새 요청은 503 으로 거절된다.
#   · 워커 상태는 /api/health/ready 의 clause_rerank 에 그대로 나온다
#     (적재 여부·처리 수·시한초과·버려진 일감·지연 p50/p95).
INSURANCE_CLAUSE_RERANK_ENABLED=false

# 리랭커에 넣을 후보 상한. 후보가 늘면 지연이 선형으로 는다.
CLAUSE_RERANK_MAX_CANDIDATES=40
# 동시에 도는 리랭킹 수. 4B 는 GPU 를 통째로 쓴다 — 겹치면 OOM 이다.
CLAUSE_RERANK_CONCURRENCY=1

# ★채점에 무엇을 넣는가 — chunk | full_clause
#   실측 2026-08-05 · 417질의 · Qwen3-Reranker-4B (RTX 4070 SUPER):
#     chunk       hit@1 0.6379
#     full_clause hit@1 0.5875   ← 5.04%p 낮다
#   면책을 **다른 말로** 물으면 격차가 +19.81%p 까지 벌어진다(0.6792 ↔ 0.4811).
#   max_length 를 768→1536 으로 올려도 이 차이는 그대로다(절단 탓이 아니다).
#   ★그래도 인용·판정은 조 전체를 본다 — 순위 매기기와 뜻 지키기는 다른 일이다.
#   full_clause 는 비교·회귀용으로 남겨 둔 옛 동작이다.
#   → docs/reports/2026-08-05_0100_리랭커_붙는자리_실측.md
CLAUSE_RERANK_SCORE_BODY=chunk

# 조항 리랭킹 전용 절단 길이.
# ★768 에서는 후보가 전부 같은 앞부분만 남아 `constant scores` 로 멈추는 질의가 있었다.
#   1536 에서 사라졌고, 조각 채점은 지연이 늘지 않는다(2,292 → 2,291ms).
CLAUSE_RERANK_MAX_LENGTH=1536

# 채점 프롬프트에 넣는 본문 길이 상한(자). 조 전체는 3만 자까지 있다.
CLAUSE_RERANK_SCORE_CHARS=1200
# ★리랭킹 시한(초). 넘으면 504 로 나간다.
#   실측 2026-08-05(RTX 4070 SUPER · 후보 20 · Qwen3-4B): 질의당 2.3초.
#   ★★시한이 지나도 추론은 안 멈춘다 — 파이썬 스레드는 강제 종료가 없다.
#     「이 요청을 포기한다」는 뜻이고, 그동안 워커는 새 요청을 받지 않는다(503).
CLAUSE_RERANK_TIMEOUT_SECONDS=30.0
# 워커 대기열. 차면 503 — 쌓아 두면 밖에서 안 보인다.
CLAUSE_RERANK_QUEUE_SIZE=8
# ★메트릭 스크레이프 전용 토큰 — 비어 있으면 /metrics-scrape 가 404 다.
#   「설정 안 했으니 열어 준다」로 흐르지 않는다(무폴백).
#   읽기 전용이고 관리자 계정과 분리돼 있다 — 새도 메트릭 조회만 된다.
#   Prometheus:  authorization: {type: Bearer, credentials: "<이 값>"}
#   생성 예:     python -c "import secrets;print(secrets.token_urlsafe(32))"
METRICS_SCRAPE_TOKEN=

# ────────────────────────────────────────────────────────────────────
# 사전판정에 붙는 **참고 조항** (벡터 의미검색)
#
# /v1/prechecks 는 조항 벡터 색인을 지금까지 한 번도 안 봤다. 판정은 질병기호
# 대조로만 하고, 대부분의 답이 「면책엔 없다, 보상하는 사항이 정한다」로 끝나면서
# **그 조항을 보여 주지 않았다.** 이 스위치가 그 자리를 메운다.
#
# ★★켜도 **판정은 안 바뀐다.** 유사도는 근거가 아니다 —
#   결과는 응답의 `related_clauses` 로만 나가고 `citations` 에 안 섞이며,
#   급도 `retrieved_clause` 로 따로 붙는다. 근거가 이미 있는 판정(면책·예외)에는
#   아예 안 붙는다.
#
# ★기본이 꺼짐인 이유 — 판정 한 건마다 임베딩 1회 + 벡터 조회 1회가 늘고,
#   이 참고 조항이 실제로 도움이 되는지 아직 실측하지 않았다.
#
# ★켜려면 pgvector 조항 색인과 임베더가 서 있어야 한다. 못 서면 판정은 그대로
#   돌고 참고 조항만 안 붙으며, 그 사실이 응답 `related_search` 와 로그에 남는다.
PRECHECK_RELATED_SEARCH_ENABLED=false
# 참고 조항을 몇 개까지 붙일까. 많을수록 화면에서 근거와 참고가 헷갈린다.
PRECHECK_RELATED_SEARCH_LIMIT=5


# ────────────────────────────────────────────────────────────────────

# S7.1 approved OCR facts mounted into the chatbot release.
# Leave unset for the repository default: data/work/s7_1_approved_facts
S7_FACT_ROOT=
