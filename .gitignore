# Hidden paths are private/local by default.  The ignore rule itself is the only exception.
.*
!.gitignore

# Local secrets and environments
.env
.env.*
.venv/
venv/

# Python/test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime databases, logs, models and generated artifacts
*.sqlite3
*.sqlite3-*
*.db
*.log
*.onnx
*.pt
*.pth
*.bin
*.gguf
artifacts/
backups/
legacy/

# Internal documents and copyrighted/private/large data
docs/
# ★backend 브랜치는 백엔드 핸드오프 문서를 함께 싣는다.
#   docs/ 를 통째로 막아 두면 계약서가 코드와 따로 놀게 된다 —
#   실제로 이 브랜치 첫 커밋에서 문서 6개가 조용히 빠졌다.
!docs/
!docs/handoff/
!docs/handoff/*.md
data/*
!data/raw/
data/raw/*
!data/raw/manifests/
!data/raw/manifests/*.jsonl

# Temporary files and archives
*.bak
*.backup
*.tmp
*.zip
*~
