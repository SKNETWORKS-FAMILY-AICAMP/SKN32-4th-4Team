# Production PostgreSQL cutover template.
# Copy to the service's private environment store and replace every placeholder.
# Do not commit the populated file or real secrets.

APP_ENV=production

LLM_PROVIDER=local
SECRET_KEY=replace-with-a-long-random-secret
INSURANCE_IDEMPOTENCY_SECRET=replace-with-a-separate-random-secret-at-least-32-chars

# Compatibility URL only. It must not point to SQLite in a production process.
DATABASE_URL=postgresql+psycopg://insurance_runtime:REPLACE_PASSWORD@127.0.0.1:5433/insurance_real

# Insurance runtime database. Use the service LOGIN role, not the owner role.
INSURANCE_PG_DSN=host=127.0.0.1 port=5433 user=insurance_runtime dbname=insurance_real
INSURANCE_ADMIN_PG_DSN=host=127.0.0.1 port=5433 user=insurance_admin dbname=insurance_real

AUTH_PERSISTENCE=postgres
OPS_PERSISTENCE=postgres
# 조항 저장소(pgvector). ★이 줄이 없으면 기본값 file 로 떨어져
#   다른 저장소는 전부 PostgreSQL 인데 판정 근거만 파일에서 읽는 상태가 된다.
#   pg 로 두려면 승인된 임베딩 프로필이 있어야 한다(없으면 기동이 명시적으로 실패한다).
CLAUSE_STORE=pg
PRECHECK_PERSISTENCE=postgres
OUTCOME_PERSISTENCE=postgres
VERIFIED_COHORT_STORE=postgres
SQLITE_LEGACY_ENABLED=false

DEMO_STORE_BACKEND=postgres
DEMO_PG_DSN=host=127.0.0.1 port=5433 user=insurance_demo_runtime dbname=insurance_demo

# Registered-agent API remains fail-closed until its keys, TLS boundary, and
# agent database/client mirror are prepared.
AGENT_API_ENABLED=false
AGENT_PG_DSN=host=127.0.0.1 port=5433 user=insurance_agent_runtime dbname=insurance_agent
AGENT_ADMIN_PG_DSN=host=127.0.0.1 port=5433 user=insurance_agent_admin dbname=insurance_agent
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8082
ALLOW_REMOTE_AGENT_BIND=false
