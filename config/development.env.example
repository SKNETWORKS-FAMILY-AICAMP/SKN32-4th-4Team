# Copy this file to the repository root as .env, then replace placeholders.
APP_ENV=development

LLM_PROVIDER=local
LLM_CHAT_ENABLED=true
LOCAL_BASE_URL=http://127.0.0.1:8002/v1
LOCAL_MODEL=gemma-4-e4b
LOCAL_API_KEY=not-needed

# Required for signup/login. Generate a long random value locally.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local development compatibility store. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./data/db/insurance.sqlite3
AUTH_PERSISTENCE=sqlite
OPS_PERSISTENCE=sqlite
PRECHECK_PERSISTENCE=off
OUTCOME_PERSISTENCE=file
VERIFIED_COHORT_STORE=file
SQLITE_LEGACY_ENABLED=true

# Optional local PostgreSQL services.
PGVECTOR_DSN=host=127.0.0.1 port=5433 user=postgres dbname=mall_vec
DEMO_STORE_BACKEND=file
DEMO_PG_DSN=host=127.0.0.1 port=5433 user=postgres dbname=insurance_demo

# Registered Agent API stays disabled until its DB and separate hash secret exist.
AGENT_API_ENABLED=false
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8082
ALLOW_REMOTE_AGENT_BIND=false
AGENT_HASH_SECRET=

# Heavy reranking is disabled by default.
INSURANCE_CLAUSE_RERANK_ENABLED=false
